{
  "name": "keepers-of-the-current",
  "private": true,
  "version": "2.0.0",
  "description": "Keepers of the Current — LARP religion site, v2",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler pages dev",
    "migrate:local": "wrangler d1 migrations apply keepers-current-db --local",
    "migrate:remote": "wrangler d1 migrations apply keepers-current-db --remote",
    "db:local": "wrangler d1 execute keepers-current-db --local",
    "db:remote": "wrangler d1 execute keepers-current-db --remote",
    "build:guides": "node scripts/build-trial-guides.mjs",
    "build:story-import": "esbuild scripts/story-import-worker.js --bundle --platform=browser --format=iife --minify --legal-comments=eof --outfile=public/assets/js/story-import-worker.js",
    "build:story-markdown": "esbuild scripts/story-markdown.js --bundle --platform=browser --format=esm --minify --legal-comments=eof --outfile=public/assets/js/story-markdown.js"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241112.0",
    "esbuild": "0.27.3",
    "linkedom": "^0.18.15",
    "miniflare": "4.20260430.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.87.0"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "ical.js": "^2.2.1",
    "jszip": "3.10.2",
    "marked": "18.1.3",
    "pdfmake": "^0.2.20"
  }
}
